# Application
APP_ENV=development
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_THIS_WITH_64_RANDOM_HEX_CHARS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
API_BASE_URL=https://kida-api.onrender.com

# Database
DATABASE_URL=postgresql+asyncpg://litmusic:litmusic@db:5432/litmusic


# Redis
REDIS_URL=redis://redis:6379/0

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET_NAME=litmusic-
S3_ENDPOINT_URL=
S3_CLOUDFRONT_URL=

# Cloudflare R2 (S3-compatible) — hosts the desktop app installers
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Flutterwave
FLW_SECRET_KEY=FLWSECK_TEST-xxxx
FLW_HASH=your-flutterwave-webhook-hash
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxx
FLUTTERWAVE_SECRET_HASH=your-flutterwave-secret-hash
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxx

# Frontend
FRONTEND_URL=https://litmusic.app

# Email (SMTP)
# For Gmail: enable 2FA and create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@litmusic.app
# Internal inbox notified on every new signup. Leave blank to disable.
ADMIN_NOTIFICATION_EMAIL=kida.audio@gmail.com

# Account deletion
# Days a self-deleted account stays restorable before it is purged for good.
# Keep in step with the deletion wording shown in-app.
ACCOUNT_DELETION_GRACE_DAYS=30

# OneSignal
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_API_KEY=your-onesignal-api-key

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=43200
REFRESH_TOKEN_EXPIRE_DAYS=30

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback


APPLE_SHARED_SECRET=<from App Store Connect → App → In-App Purchases → Shared Secret>
# Subscription receipt verification (legacy /verifyReceipt). Falls back to APPLE_SHARED_SECRET.
APP_STORE_SHARED_SECRET=<App Store Connect → App → App-Specific Shared Secret>
GOOGLE_SERVICE_ACCOUNT_JSON=<full JSON content of the service account key file>

# IAP price sync — Google Play (androidpublisher v3)
# Defaults to GOOGLE_SERVICE_ACCOUNT_JSON if left blank; the service account
# needs the "Manage store presence" / financial-data permission.
ANDROID_PACKAGE_NAME=com.litecode.kida
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=<full JSON content of the Play service account key file>

# IAP price sync — App Store Connect API (ES256 JWT auth)
APP_STORE_ISSUER_ID=<App Store Connect → Users and Access → Integrations → Issuer ID>
APP_STORE_KEY_ID=<the API key's Key ID>
APP_STORE_PRIVATE_KEY=<PEM contents of the .p8 key; escaped \n newlines allowed>
APP_STORE_APP_ID=<numeric Apple app ID that owns the in-app purchases>
APP_STORE_REVIEW_SCREENSHOT_PATH=/app/assets/iap-review-screenshot.png

# IAP — RevenueCat (trusted store-subscription source of truth)
# Secret v1 REST API key: RevenueCat dashboard → Project → API keys → Secret key.
REVENUECAT_API_KEY=<RevenueCat project secret API key>
# Entitlement identifier configured in RevenueCat that maps to Kiɗa Premium.
REVENUECAT_ENTITLEMENT_ID=premium
# Shared secret set as the webhook "Authorization header" value in RevenueCat
# (Project → Integrations → Webhooks). Incoming webhooks must present it verbatim;
# leaving it blank makes /subscriptions/webhook/revenuecat reject all requests.
REVENUECAT_WEBHOOK_AUTH_HEADER=<shared webhook Authorization header value>

# IAP price sync — worker
PRICE_SYNC_NGN_PER_USD=1600
PRICE_SYNC_INTERVAL_SECONDS=600

# App installers (desktop download) — object keys within the R2 bucket
APP_INSTALLER_MACOS_S3_KEY=installers/kida-macos.dmg
APP_INSTALLER_WINDOWS_S3_KEY=installers/kida-windows.exe

R2_ENDPOINT_URL=https://287a660a99ab2508b6e50492e4e2fe77.eu.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=921d8a36574b0726caad48303b67bbec
R2_SECRET_ACCESS_KEY=1ac94be48d58d5755583a4569c44e69ce3871fdc51865cbf312551f895a98fc3
R2_BUCKET_NAME=litmusic

# Free-tier download caps (lifetime grants per account, FREE content only;
# subscribers and per-item purchasers are exempt). Tunable without a deploy.
FREE_TIER_LOOP_DOWNLOADS=2
FREE_TIER_DRUM_KIT_DOWNLOADS=1
FREE_TIER_DRONE_PAD_DOWNLOADS=1
# One whole free drone group (all its keys) per free account.
FREE_TIER_DRONE_GROUP_DOWNLOADS=1